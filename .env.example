# Copy this file to .env. Never upload your .env to GitHub.
# Run the model separately: ollama pull qwen3:4b-instruct
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_CHAT_MODEL=qwen3:4b-instruct

# Optional local Whisper transcription: use absolute paths for YOUR machine.
# Windows example: WHISPER_CLI=C:/tools/whisper/whisper-cli.exe
# WHISPER_CLI=/absolute/path/to/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-small.bin

# Optional real SMS delivery (provider charges may apply).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Optional real email delivery (provider charges may apply).
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional hosting configuration; local defaults need no changes.
# HOST=0.0.0.0
# PORT=8787
# PUBLIC_ORIGIN=https://your-domain.example
# KHATA_DATABASE=/persistent-disk/khata.sqlite3
